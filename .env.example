# Copy to .env (git-ignored) and fill in. Never commit real values.

# Password of the local PostgreSQL started by docker-compose.
POSTGRES_PASSWORD=change-me

# Worker connection string. Same password as above.
ORUS_DATABASE_URL=postgres://orus:change-me@127.0.0.1:55432/orus?sslmode=disable

# Integration tests: they are skipped when this is not set.
ORUS_TEST_DATABASE_URL=postgres://orus:change-me@127.0.0.1:55432/orus_test?sslmode=disable

# API (go run ./cmd/api). Defaults shown.
# ORUS_API_ADDR=127.0.0.1:8080
# Other origins allowed to send state-changing requests (dashboard dev server).
# ORUS_API_TRUSTED_ORIGINS=http://localhost:5173
# Required: encrypts TOTP secrets in the database. Generate with
#   openssl rand -base64 32
# Losing it invalidates every user's MFA; never store it with the backups.
ORUS_MFA_KEY=
# Seals customers' test accounts (authenticated scans); the API and the
# worker need the same value: openssl rand -base64 32. Unset: no test account
# can be stored, scans run without login.
ORUS_CREDENTIALS_KEY=

# Microsoft 365 audits (step K): our multi-tenant app registered in Microsoft
# Entra, with the read-only application permissions listed in
# engine/internal/modules/m365 and the redirect URI
# <ORUS_PUBLIC_URL>/api/v1/identities/m365/callback. The API and the worker
# need both values. Unset: Microsoft 365 cannot be connected.
ORUS_M365_CLIENT_ID=
ORUS_M365_CLIENT_SECRET=

# Email (password reset, invitations, alerts). In development, Mailpit from
# docker-compose catches every email: read them at http://localhost:8025.
# Unset ORUS_SMTP_ADDR: no email is sent. In production: the provider's SMTP
# relay (port 587, STARTTLS), with ORUS_SMTP_USERNAME and ORUS_SMTP_PASSWORD.
ORUS_SMTP_ADDR=127.0.0.1:1025
ORUS_MAIL_FROM="Orus Shield <no-reply@orus.localhost>"
# The dashboard's address, used in email links.
# ORUS_PUBLIC_URL=http://localhost:5173

# DNS server for every lookup of the worker, the API and orusctl (modules,
# ownership checks): an IP, optionally with a port. Unset: the machine's
# resolver. Production should set it (Unbound on the host, or 1.1.1.1): a
# network's resolver may keep stale answers for hours.
# ORUS_DNS_SERVER=1.1.1.1

# Nuclei for the vulns module (known vulnerabilities), worker only. Install the
# pinned versions with deploy/nuclei/install.sh, which prints both lines
# (absolute paths). Unset: the vulns module fails its runs with a clear error.
# ORUS_NUCLEI_BIN=/abs/path/to/orus-shield/.tools/nuclei/nuclei
# ORUS_NUCLEI_TEMPLATES=/abs/path/to/orus-shield/.tools/nuclei/nuclei-templates

# Data leaks (worker, leaks module): XposedOrNot. Unset, its public API on the
# free community tier (low volume). Commercial use needs a licence from
# XposedOrNot; a paid key goes here.
# ORUS_XON_BASE_URL=https://api.xposedornot.com
# ORUS_XON_API_KEY=

# Card and PayPal payments with Paddle Billing (API only): all or none. Sandbox
# first: https://sandbox-vendors.paddle.com > Developer tools (API key, client
# token), Notifications (destination https://APP/api/v1/billing/paddle, events
# subscription.*, its secret key), Catalog (the four prices).
ORUS_PADDLE_ENVIRONMENT=sandbox
ORUS_PADDLE_API_KEY=
ORUS_PADDLE_CLIENT_TOKEN=
ORUS_PADDLE_WEBHOOK_SECRET=
ORUS_PADDLE_PRICE_SME_MONTHLY=
ORUS_PADDLE_PRICE_SME_YEARLY=
ORUS_PADDLE_PRICE_PRO_MONTHLY=
ORUS_PADDLE_PRICE_PRO_YEARLY=
# The same four offers with a 14-day trial (Paddle: price > Trial period 14
# days). An organization's first checkout uses them: card or PayPal given at
# the start, charged at the trial's end unless canceled. One per organization.
ORUS_PADDLE_TRIAL_PRICE_SME_MONTHLY=
ORUS_PADDLE_TRIAL_PRICE_SME_YEARLY=
ORUS_PADDLE_TRIAL_PRICE_PRO_MONTHLY=
ORUS_PADDLE_TRIAL_PRICE_PRO_YEARLY=
