# Copy to .env (git-ignored) and fill in. Never commit real values.

# Password of the local PostgreSQL started by docker-compose.
POSTGRES_PASSWORD=change-me

# Worker connection string. Same password as above.
ORUS_DATABASE_URL=postgres://orus:change-me@127.0.0.1:55432/orus?sslmode=disable

# Integration tests: they are skipped when this is not set.
ORUS_TEST_DATABASE_URL=postgres://orus:change-me@127.0.0.1:55432/orus_test?sslmode=disable

# API (go run ./cmd/api). Defaults shown.
# ORUS_API_ADDR=127.0.0.1:8080
# Other origins allowed to send state-changing requests (dashboard dev server).
# ORUS_API_TRUSTED_ORIGINS=http://localhost:5173
# Required: encrypts TOTP secrets in the database. Generate with
#   openssl rand -base64 32
# Losing it invalidates every user's MFA; never store it with the backups.
ORUS_MFA_KEY=

# Email (password reset, invitations, alerts). In development, Mailpit from
# docker-compose catches every email: read them at http://localhost:8025.
# Unset ORUS_SMTP_ADDR: no email is sent. In production: the provider's SMTP
# relay (port 587, STARTTLS), with ORUS_SMTP_USERNAME and ORUS_SMTP_PASSWORD.
ORUS_SMTP_ADDR=127.0.0.1:1025
ORUS_MAIL_FROM="Orus Shield <no-reply@orus.localhost>"
# The dashboard's address, used in email links.
# ORUS_PUBLIC_URL=http://localhost:5173
