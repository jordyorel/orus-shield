# The API's own settings (/etc/orus/api.env, root, mode 0600).

# Peer authentication over the Unix socket: no password (postgres-roles.sql).
ORUS_DATABASE_URL=postgres://orus_api@/orus?host=/var/run/postgresql
# Not 8080: ZAP's default port, and ZAP shares the host's network.
ORUS_API_ADDR=127.0.0.1:8180
# Caddy, on this machine: its X-Forwarded-For is believed, nobody else's.
ORUS_TRUSTED_PROXIES=127.0.0.1

# Encrypts TOTP secrets. Generated by setup.sh. Keep a copy in a password
# manager, never next to the backups: losing it invalidates every user's
# two-factor enrolment.
ORUS_MFA_KEY=@MFA_KEY@

# closed: invitation only. Remove the line to open self-service signup.
ORUS_SIGNUP=closed

# Paddle Billing, production account (all or none). Webhook destination:
# https://@DOMAIN@/api/v1/billing/paddle, events subscription.*.
ORUS_PADDLE_ENVIRONMENT=production
ORUS_PADDLE_API_KEY=
ORUS_PADDLE_CLIENT_TOKEN=
ORUS_PADDLE_WEBHOOK_SECRET=
ORUS_PADDLE_PRICE_SME_MONTHLY=
ORUS_PADDLE_PRICE_SME_YEARLY=
ORUS_PADDLE_PRICE_PRO_MONTHLY=
ORUS_PADDLE_PRICE_PRO_YEARLY=
ORUS_PADDLE_TRIAL_PRICE_SME_MONTHLY=
ORUS_PADDLE_TRIAL_PRICE_SME_YEARLY=
ORUS_PADDLE_TRIAL_PRICE_PRO_MONTHLY=
ORUS_PADDLE_TRIAL_PRICE_PRO_YEARLY=
