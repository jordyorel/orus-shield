# Settings both the API and the worker read. setup.sh installs this file as
# /etc/orus/shared.env (root, mode 0600: systemd reads it before starting
# the services as their own users) and fills the @...@ values; edit the
# rest by hand, then: systemctl restart orus-api orus-worker.

# The site's address, in email links and Microsoft's redirect URI.
ORUS_PUBLIC_URL=https://@DOMAIN@

# Unbound on this server (unbound.conf).
ORUS_DNS_SERVER=127.0.0.1:5335

# Seals customers' test accounts and webhook secrets. Generated by
# setup.sh. Keep a copy in a password manager, never next to the backups:
# losing it makes every stored test account and webhook unusable.
ORUS_CREDENTIALS_KEY=@CREDENTIALS_KEY@

# Email: the provider's SMTP relay on the product domain (port 587,
# STARTTLS; Hetzner blocks 25 and 465 on new servers). Publish the
# provider's SPF and DKIM records and a DMARC policy for the domain first.
ORUS_SMTP_ADDR=
ORUS_SMTP_USERNAME=
ORUS_SMTP_PASSWORD=
ORUS_MAIL_FROM="Orus Shield <no-reply@@DOMAIN@>"

# Microsoft 365 audits: the multi-tenant app's ID and secret, with
# https://@DOMAIN@/api/v1/identities/m365/callback as its redirect URI.
# Empty: Microsoft 365 cannot be connected.
ORUS_M365_CLIENT_ID=
ORUS_M365_CLIENT_SECRET=
