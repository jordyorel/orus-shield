# The worker's own settings (/etc/orus/worker.env, root, mode 0600).

# The schema owner, by peer authentication (postgres-roles.sql).
ORUS_DATABASE_URL=postgres://orus@/orus?host=/var/run/postgresql

# The scanners' proxies listen on these ports of 127.0.0.1 only: the
# firewall lets the sandbox reach them and nothing else (firewall.nft).
ORUS_GATEPROXY_PORTS=61000-61999

# Nuclei (vulns module), installed by setup.sh; the binary is setgid
# orus-scan, the group the firewall confines (firewall.nft).
ORUS_NUCLEI_BIN=/opt/orus/nuclei/nuclei
ORUS_NUCLEI_TEMPLATES=/opt/orus/nuclei/nuclei-templates

# ZAP (deep profile), pulled by setup.sh. Host network, gateproxy on the
# loopback; uid 1000 is the image's zap user, the gid is orus-scan's, so
# the firewall confines the container too.
ORUS_ZAP_IMAGE=@ZAP_IMAGE@
ORUS_ZAP_NETWORK=host
ORUS_ZAP_PROXY_HOST=127.0.0.1
ORUS_ZAP_USER=1000:@SCAN_GID@
ORUS_ZAP_WORKDIR=/var/lib/orus/zap

# Data leaks: XposedOrNot's free tier until the paid plan is taken.
# ORUS_XON_API_KEY=
