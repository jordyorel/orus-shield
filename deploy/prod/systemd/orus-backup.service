# Daily database dump (orus-backup.timer). Installed by setup.sh.
[Unit]
Description=Orus Shield database backup
Requires=postgresql.service
After=postgresql.service

[Service]
Type=oneshot
User=postgres
ExecStart=/usr/local/libexec/orus/backup.sh
ProtectSystem=strict
ReadWritePaths=/var/backups/orus
PrivateTmp=yes
NoNewPrivileges=yes
